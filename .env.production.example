DJANGO_PRODUCTION=true
ENV_FILE=.env.production.example
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-this-with-64-cryptographically-random-characters-before-deploy
DJANGO_ALLOWED_HOSTS=sredi.example.mk
DOMAIN=sredi.example.mk
CERTBOT_EMAIL=ops@example.mk
HSTS_MAX_AGE=300
CSRF_TRUSTED_ORIGINS=https://sredi.example.mk
TRUSTED_PROXY_IPS=172.16.0.0/12
MAX_ISSUE_PHOTOS=5
MAX_ISSUE_IMAGE_SIZE_BYTES=5242880
ISSUE_IMAGE_MAX_PIXEL_COUNT=24000000
ISSUE_IMAGE_MAX_LONG_EDGE=2048
ISSUE_IMAGE_MIN_LONG_EDGE=1024
ISSUE_IMAGE_MAX_OUTPUT_SIZE_BYTES=819200
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DB_CONN_MAX_AGE=60
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
STORAGE_WARNING_PERCENT=70
STORAGE_URGENT_PERCENT=80
STORAGE_CRITICAL_PERCENT=90
STORAGE_MONITOR_ENABLED=true
OPERATIONS_ALERT_EMAILS=ops@example.mk

POSTGRES_DB=opstinski_inbox
POSTGRES_USER=opstinski_inbox
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.mk
EMAIL_HOST=smtp.example.mk
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

PLATFORM_OPERATOR_NAME=Sredi / Opštinski Inbox
PRIVACY_CONTACT_EMAIL=privacy@example.mk
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

RESTIC_REPOSITORY=/data/restic
RESTIC_PASSWORD=replace-with-a-separate-long-backup-key
MEDIA_MAINTENANCE_LOCK_ID=734733
