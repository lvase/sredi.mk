DJANGO_PRODUCTION=true
ENV_FILE=.env.production.example
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-this-with-64-cryptographically-random-characters-before-deploy
DJANGO_ALLOWED_HOSTS=sredi.example.mk
DOMAIN=sredi.example.mk
CERTBOT_EMAIL=ops@example.mk
HSTS_MAX_AGE=300
CSRF_TRUSTED_ORIGINS=https://sredi.example.mk
TRUSTED_PROXY_IPS=172.16.0.0/12

POSTGRES_DB=opstinski_inbox
POSTGRES_USER=opstinski_inbox
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.mk
EMAIL_HOST=smtp.example.mk
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

PLATFORM_OPERATOR_NAME=Sredi / Opštinski Inbox
PRIVACY_CONTACT_EMAIL=privacy@example.mk
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/sredi
RESTIC_PASSWORD=replace-with-a-separate-long-backup-key
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
